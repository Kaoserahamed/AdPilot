# AdPilot environment template
# Copy to .env for local development. Never commit .env.

APP_ENV=development
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://adpilot:adpilot@localhost:5432/adpilot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-development-secret
STORAGE_DIR=./storage
AUTH_DB_PATH=./storage/adpilot.db
CREATIVE_MAX_FILE_SIZE_BYTES=25000000

# External services. Leave blank to use deterministic local adapters.
AI_API_KEY=
AI_PROVIDER=mock
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/platforms/meta/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/platforms/google/callback

# Set to false only when explicitly using a live provider.
LIVE_EXTERNAL_APIS=false
